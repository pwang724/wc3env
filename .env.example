# Copy to .env and adjust. Real environment variables override these.
WC3_GAME_DIR=C:\Program Files (x86)\Warcraft III (Legacy)
WC3_USER_DIR=C:\Users\you\Documents\Warcraft III
WC3_MAP=Maps/FrozenThrone/(2)EchoIsles.w3x
# Optional: a separately built DLL (otherwise use the bundled or checkout build).
# WC3_HOOK_DLL=D:\builds\wc3hook.dll
# Optional output parent for standalone environment launches. Each process gets
# a unique subfolder. Explicit launch(output_dir=...) / GameConfig.output_dir wins.
# WC3_OUTPUT_DIR=D:\sessions\standalone\env
# Sound is on by default. Tests set this to 0 automatically; use 0 for other automation.
# WC3_SOUND=1

# Optional game-data extraction library; source checkouts also search tools/StormLib.
# STORMLIB_DLL=C:\path\to\StormLib.dll

# Agent settings (only needed when running wc3agent/).
# TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest
# Macro model for `python -m wc3agent melee`: openai means any OpenAI-compatible endpoint.
# MACRO_PROVIDER=anthropic
# MACRO_MODEL=
# ANTHROPIC_API_KEY=            (or OPENAI_API_KEY, or MACRO_API_KEY with MACRO_BASE_URL)
# ANTHROPIC_AUTH_TOKEN=         Claude subscription instead of an API key: the sk-ant-oat token from `claude setup-token`
# MACRO_REASONING=medium        low | medium | high | xhigh
# New agent runs create <session>/agent and <session>/env below this directory.
# Default: ./sessions. Under Wine, use Z:\sessions for a Linux /sessions mount.
# AGENT_SESSIONS_DIR=D:\sessions
